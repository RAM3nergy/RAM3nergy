---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'RAM3nergy — Solar Energy & Custom LiFePO4 Battery Packs | Islamabad',
  description = 'RAM3nergy builds high-precision solar systems and custom LiFePO4 battery packs in Islamabad, Pakistan. Grade-A+ cells, lab-tested, 5-year warranty. Zero load-shedding, engineered locally.',
} = Astro.props;

const ogImage = new URL('/og-cover.svg', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#00411C" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={ogImage.href} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />

    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'RAM3nergy',
      slogan: 'Cybersecurity & Energy Engineering | World-Class Cells, Indigenous Engineering',
      url: Astro.site,
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Islamabad',
        addressCountry: 'PK',
      },
      makesOffer: [
        { '@type': 'Offer', itemOffered: { '@type': 'Product', name: 'Markhor Series LiFePO4 Battery Pack' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Product', name: 'Urial Series LiFePO4 Battery Pack' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Product', name: 'Marco Polo Commercial BESS' } },
      ],
    })} />

    <title>{title}</title>
  </head>
  <body class="min-h-screen">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-primary focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>

    <Navbar />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <!-- Sticky floating WhatsApp launcher -->
    <a
      href="https://wa.me/923455124790?text=Assalam-o-Alaikum%20RAM3nergy!%20I%20need%20help%20sizing%20a%20LiFePO4%20battery%20pack%20for%20my%20home.%20Can%20you%20advise%3F"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Chat with RAM3nergy on WhatsApp"
      class="fixed bottom-5 right-5 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-whatsapp text-white shadow-xl shadow-whatsapp/40 transition hover:scale-105 focus:outline-none focus:ring-4 focus:ring-whatsapp/40"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" class="h-7 w-7" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
      </svg>
    </a>
  </body>
</html>
