---
import { WHATSAPP_NUMBER } from '../data/site.js';

const inquiryTypes = [
  'Solar System Sizing',
  'Battery Pack Purchase',
  'Custom Battery Build',
  'Commercial BESS (Marco Polo)',
  'Repair / BMS Replacement',
  'Other',
];
---

<section id="contact" class="bg-surface py-20 lg:py-28">
  <div class="container-ram">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
      <!-- Left: pitch + direct channels -->
      <div>
        <span class="text-xs font-bold uppercase tracking-widest text-accent">Contact &amp; Custom Engineering</span>
        <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-primary sm:text-4xl">
          Tell Us Your Load. We'll Engineer the Rest.
        </h2>
        <p class="mt-4 leading-relaxed text-slate-600">
          From a single inverter backup to a 500 kWh commercial BESS — submit your requirement
          and an engineer (not a salesperson) will respond with a sizing recommendation and a
          formal quotation.
        </p>

        <dl class="mt-8 space-y-4">
          <div class="flex items-start gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
            </div>
            <div>
              <dt class="text-sm font-bold text-secondary">Workshop &amp; Lab</dt>
              <dd class="text-sm text-slate-500">Islamabad, Pakistan — serving Islamabad, Rawalpindi &amp; nationwide shipping</dd>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
              </svg>
            </div>
            <div>
              <dt class="text-sm font-bold text-secondary">WhatsApp / Call</dt>
              <dd class="text-sm text-slate-500">+92 345 5124 790 · Mon–Sat, 9:00–19:00 PKT</dd>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
                <rect x="2" y="4" width="20" height="16" rx="2" />
                <path d="m22 7-10 6L2 7" />
              </svg>
            </div>
            <div>
              <dt class="text-sm font-bold text-secondary">Email</dt>
              <dd class="text-sm text-slate-500">sales@ram3nergy.pk</dd>
            </div>
          </div>
        </dl>
      </div>

      <!-- Right: form -->
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-card sm:p-8">
        <form id="contact-form" novalidate>
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="cf-name" class="label-ram">Full Name *</label>
              <input id="cf-name" name="name" type="text" required autocomplete="name"
                placeholder="e.g. Ahmed Khan" class="input-ram" />
            </div>
            <div>
              <label for="cf-location" class="label-ram">Location *</label>
              <select id="cf-location" name="location" required class="input-ram">
                <option value="">Select…</option>
                <option>Islamabad</option>
                <option>Rawalpindi</option>
                <option>Other (Pakistan)</option>
                <option>Overseas / N/A</option>
              </select>
            </div>
            <div>
              <label for="cf-inquiry" class="label-ram">Inquiry Type *</label>
              <select id="cf-inquiry" name="inquiry" required class="input-ram">
                <option value="">Select…</option>
                {inquiryTypes.map((t) => <option>{t}</option>)}
              </select>
            </div>
            <div>
              <label for="cf-capacity" class="label-ram">Solar Capacity (kW)</label>
              <input id="cf-capacity" name="capacity" type="text" inputmode="decimal"
                placeholder="e.g. 10 kW (leave blank if unknown)" class="input-ram" />
            </div>
            <div class="sm:col-span-2">
              <label for="cf-custom" class="label-ram">Custom Battery Build (optional)</label>
              <input id="cf-custom" name="custom" type="text"
                placeholder="e.g. 51.2V 400Ah wall-mount pack with 8kW inverter" class="input-ram" />
            </div>
            <div class="sm:col-span-2">
              <label for="cf-message" class="label-ram">Project Details</label>
              <textarea id="cf-message" name="message" rows="4"
                placeholder="Typical appliances, daily usage, current backup setup, budget range…"
                class="input-ram resize-y"></textarea>
            </div>
          </div>

          <p id="cf-error" class="mt-3 hidden text-sm font-semibold text-red-600" role="alert"></p>

          <button type="submit" class="btn btn-whatsapp mt-6 w-full !py-3.5 text-base">
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
            </svg>
            Submit via WhatsApp
          </button>
          <p class="mt-3 text-center text-xs text-slate-400">
            Opens WhatsApp with your inquiry pre-filled — nothing is sent until you press send.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<script id="wa-number" type="application/json" set:html={JSON.stringify(WHATSAPP_NUMBER)} />

<script is:inline>
  (function () {
    var WA_NUMBER = JSON.parse(document.getElementById('wa-number').textContent);
    var form = document.getElementById('contact-form');
    var errEl = document.getElementById('cf-error');

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      errEl.classList.add('hidden');

      var name = form.elements['name'].value.trim();
      var location = form.elements['location'].value;
      var inquiry = form.elements['inquiry'].value;
      var capacity = form.elements['capacity'].value.trim();
      var custom = form.elements['custom'].value.trim();
      var message = form.elements['message'].value.trim();

      if (!name || !location || !inquiry) {
        errEl.textContent = 'Please fill in your name, location, and inquiry type.';
        errEl.classList.remove('hidden');
        return;
      }

      var lines = [
        'Assalam-o-Alaikum RAM3nergy! Inquiry from your website:',
        'Name: ' + name,
        'Inquiry type: ' + inquiry,
      ];
      if (capacity) lines.push('Solar capacity: ' + capacity);
      if (custom) lines.push('Custom build: ' + custom);
      lines.push('Location: ' + location);
      if (message) lines.push('Details: ' + message);

      var url = 'https://wa.me/' + WA_NUMBER + '?text=' + encodeURIComponent(lines.join('\n'));
      window.open(url, '_blank', 'noopener,noreferrer');
    });
  })();
</script>
