---
const pillars = [
  {
    title: 'Lab-Tested Cells, Every Batch',
    body: 'No grey-market guessing. Every cell shipment goes on our internal-resistance meter and capacity test rig before it enters a pack. Cells that miss spec are rejected — not "balanced away".',
    stat: '100% IR + capacity tested',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true"><path d="M9 3h6M10 3v6.34L4.9 18.7A2 2 0 0 0 6.66 21.5h10.68a2 2 0 0 0 1.76-2.8L14 9.34V3"/><path d="M7.5 14h9"/></svg>`,
  },
  {
    title: 'QR-Code Traceability',
    body: 'Each pack ships with a QR-linked build sheet: cell batch numbers, IR readings, voltage-matching data, and assembly date. Scan it and see exactly what is inside your battery.',
    stat: 'Full provenance per pack',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M14 14h3v3h-3zM20 14h1M14 20h1M20 20h1M17 20h.01M20 17h.01"/></svg>`,
  },
  {
    title: '48-Hour Local SLA',
    body: 'Islamabad and Rawalpindi get a 48-hour response window on warranty and service calls. A real workshop, real engineers, real spares — not an imported box with no one behind it.',
    stat: '48 h response · ISB/RWP',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>`,
  },
];
---

<section id="transparency" class="relative overflow-hidden bg-primary py-20 lg:py-28">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute -left-24 -top-24 h-72 w-72 rounded-full bg-accent/10 blur-3xl"></div>
    <div class="absolute -bottom-24 -right-24 h-72 w-72 rounded-full bg-white/5 blur-3xl"></div>
  </div>

  <div class="container-ram relative">
    <div class="max-w-2xl">
      <span class="text-xs font-bold uppercase tracking-widest text-emerald-300">Radical Transparency</span>
      <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
        We Show Our Work. Every Cell. Every Pack.
      </h2>
      <p class="mt-4 leading-relaxed text-emerald-100/90">
        The Pakistani market is flooded with relabelled, second-life cells sold as Grade-A.
        RAM3nergy exists to kill that practice — with a local laboratory, documented testing,
        and an SLA we actually have to show up for.
      </p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {pillars.map((p) => (
        <article class="rounded-2xl border border-white/10 bg-white/[0.06] p-6 backdrop-blur-sm transition hover:bg-white/[0.09] sm:p-8">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-accent/15 text-accent">
            <Fragment set:html={p.icon} />
          </div>
          <h3 class="mt-5 text-lg font-bold text-white">{p.title}</h3>
          <p class="mt-2.5 text-sm leading-relaxed text-emerald-100/85">{p.body}</p>
          <p class="mt-5 inline-flex items-center gap-2 rounded-full bg-emerald-400/10 px-3 py-1 text-xs font-bold text-emerald-300">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5" aria-hidden="true">
              <path d="M20 6 9 17l-5-5" />
            </svg>
            {p.stat}
          </p>
        </article>
      ))}
    </div>

    <div class="mt-10 flex flex-col items-start justify-between gap-4 rounded-2xl border border-white/10 bg-white/[0.04] p-6 sm:flex-row sm:items-center">
      <p class="text-sm text-emerald-100/90">
        Want to watch your cells get tested before assembly?
        <strong class="text-white">Book a lab visit</strong> — we have nothing to hide.
      </p>
      <a
        href="https://wa.me/923455124790?text=Assalam-o-Alaikum%20RAM3nergy!%20I%27d%20like%20to%20book%20a%20lab%20visit%20to%20see%20cell%20testing%20before%20my%20pack%20is%20assembled."
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-ghost-dark shrink-0"
      >
        Book a Lab Visit
      </a>
    </div>
  </div>
</section>
