---
import { APPLIANCES, CALC, CALC_PACKS, WHATSAPP_NUMBER } from '../data/site.js';

const calcData = JSON.stringify({ appliances: APPLIANCES, calc: CALC, packs: CALC_PACKS, whatsapp: WHATSAPP_NUMBER });
---

<section id="calculator" class="bg-white py-20 lg:py-28">
  <div class="container-ram">
    <div class="max-w-2xl">
      <span class="text-xs font-bold uppercase tracking-widest text-accent">Battery Sizing Tool</span>
      <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-primary sm:text-4xl">
        Size Your Backup in 60 Seconds
      </h2>
      <p class="mt-4 text-slate-600">
        Select your appliances and backup target — our engine computes your connected load,
        daily energy demand, and surge headroom, then recommends the right pack with a real
        run-time estimate.
      </p>
    </div>

    <div class="mt-10 grid gap-8 lg:grid-cols-[1fr_400px]">
      <!-- Appliance picker -->
      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-card sm:p-7">
        <h3 class="text-sm font-bold uppercase tracking-wide text-slate-500">1 · Your Appliances</h3>

        <ul class="mt-4 divide-y divide-slate-100">
          {APPLIANCES.map((a) => (
            <li class="flex items-center justify-between gap-3 py-3.5">
              <div class="min-w-0">
                <p class="truncate text-sm font-semibold text-secondary">{a.label}</p>
                <p class="text-xs text-slate-400">{a.watts} W running · ~{a.hours} h/day typical</p>
              </div>
              <div class="flex shrink-0 items-center gap-1.5" data-appliance={a.id}>
                <button
                  type="button"
                  data-action="dec"
                  class="flex h-9 w-9 items-center justify-center rounded-lg border border-slate-300 text-lg font-bold text-slate-500 transition hover:border-primary hover:text-primary"
                  aria-label={`Remove one ${a.label}`}
                >−</button>
                <input
                  type="number"
                  inputmode="numeric"
                  min="0"
                  max={a.max}
                  value="0"
                  data-qty
                  class="h-9 w-12 rounded-lg border border-slate-300 text-center text-sm font-bold text-secondary focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30"
                  aria-label={`Quantity of ${a.label}`}
                />
                <button
                  type="button"
                  data-action="inc"
                  class="flex h-9 w-9 items-center justify-center rounded-lg border border-slate-300 text-lg font-bold text-slate-500 transition hover:border-primary hover:text-primary"
                  aria-label={`Add one ${a.label}`}
                >+</button>
              </div>
            </li>
          ))}
        </ul>

        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          <div>
            <label for="backup-hours" class="label-ram">2 · Backup Target (hours)</label>
            <select id="backup-hours" class="input-ram">
              <option value="2">2 hours — short outages</option>
              <option value="4" selected>4 hours — typical K-Electric outage</option>
              <option value="6">6 hours — extended outage</option>
              <option value="8">8 hours — full night (partial load)</option>
              <option value="12">12 hours — heavy load-shedding area</option>
              <option value="24">24 hours — off-grid / critical</option>
            </select>
          </div>
          <p class="self-end text-xs leading-relaxed text-slate-400">
            Estimates assume {Math.round(CALC.MAX_DOD * 100)}% usable depth-of-discharge and
            {Math.round(CALC.INVERTER_EFF * 100)}% inverter efficiency. Surge (motor startup)
            headroom is checked automatically.
          </p>
        </div>
      </div>

      <!-- Result panel -->
      <aside class="lg:sticky lg:top-28 lg:self-start">
        <div class="rounded-2xl border border-primary/15 bg-gradient-to-b from-primary-50 to-white p-6 shadow-card sm:p-7">
          <h3 class="text-sm font-bold uppercase tracking-wide text-slate-500">Your Result</h3>

          <div id="calc-empty" class="py-10 text-center">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mx-auto h-10 w-10 text-slate-300" aria-hidden="true">
              <rect x="4" y="2" width="16" height="20" rx="2" />
              <path d="M8 6h8M8 10h.01M12 10h.01M16 10h.01M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01M16 18h.01" />
            </svg>
            <p class="mt-3 text-sm text-slate-500">
              Add at least one appliance to see your recommended pack.
            </p>
          </div>

          <div id="calc-result" class="hidden" aria-live="polite">
            <dl class="mt-4 space-y-2.5 text-sm">
              <div class="flex justify-between gap-4">
                <dt class="text-slate-500">Connected load</dt>
                <dd class="font-bold text-secondary"><span id="r-load">–</span></dd>
              </div>
              <div class="flex justify-between gap-4">
                <dt class="text-slate-500">Peak surge demand</dt>
                <dd class="font-bold text-secondary"><span id="r-surge">–</span></dd>
              </div>
              <div class="flex justify-between gap-4">
                <dt class="text-slate-500">Daily energy use</dt>
                <dd class="font-bold text-secondary"><span id="r-daily">–</span></dd>
              </div>
            </dl>

            <div class="mt-5 rounded-xl bg-primary p-5 text-white">
              <p class="text-xs font-bold uppercase tracking-widest text-emerald-200">Recommended Pack</p>
              <p id="r-pack" class="mt-1 text-2xl font-extrabold">–</p>
              <p id="r-series" class="text-sm text-emerald-100">–</p>

              <div class="mt-4 space-y-2 border-t border-white/20 pt-4 text-sm">
                <div class="flex justify-between gap-4">
                  <span class="text-emerald-100">Run-time at full load</span>
                  <span id="r-runtime" class="font-bold">–</span>
                </div>
                <div class="flex justify-between gap-4">
                  <span class="text-emerald-100">Covers your backup target</span>
                  <span id="r-covers" class="font-bold">–</span>
                </div>
                <div class="flex justify-between gap-4">
                  <span class="text-emerald-100">Estimated price</span>
                  <span id="r-price" class="font-bold">–</span>
                </div>
              </div>
            </div>

            <a
              id="r-cta"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-whatsapp mt-5 w-full"
            >
              Get This Quote on WhatsApp
            </a>
            <a href="#tiers" class="mt-3 block text-center text-xs font-semibold text-primary underline-offset-2 hover:underline">
              Compare series specifications →
            </a>
          </div>

          <!-- Custom engineering fallback -->
          <div id="calc-custom" class="hidden" aria-live="polite">
            <div class="mt-4 rounded-xl bg-secondary p-5 text-white">
              <p class="text-xs font-bold uppercase tracking-widest text-accent">Beyond Standard Packs</p>
              <p class="mt-2 text-sm leading-relaxed text-slate-200">
                Your requirement needs <strong id="c-required">–</strong> of usable storage —
                that's <strong>Marco Polo Series</strong> territory. Our engineers will design a
                custom 3-phase BESS for you.
              </p>
            </div>
            <a
              id="c-cta"
              href="#contact"
              class="btn btn-accent mt-5 w-full"
            >
              Request Custom Engineering
            </a>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>

<script id="calc-data" type="application/json" set:html={calcData} />

<script is:inline>
  (function () {
    var cfg = JSON.parse(document.getElementById('calc-data').textContent);
    var APPLIANCES = cfg.appliances;
    var CALC = cfg.calc;
    var PACKS = cfg.packs;
    var WA_NUMBER = cfg.whatsapp;

    var PRICES = {
      'urial-5k': 295000,
      'urial-10k': 560000,
      'markhor-14k': 850000,
    };
    var SERIES_LABEL = { urial: 'Urial Series · Value Tier', markhor: 'Markhor Series · Apex Tier' };

    var qty = {};
    APPLIANCES.forEach(function (a) { qty[a.id] = 0; });

    var $ = function (id) { return document.getElementById(id); };
    var emptyEl = $('calc-empty');
    var resultEl = $('calc-result');
    var customEl = $('calc-custom');

    function fmtW(w) { return w >= 1000 ? (w / 1000).toFixed(1) + ' kW' : Math.round(w) + ' W'; }
    function fmtHours(h) {
      if (h >= 48) return (h / 24).toFixed(1) + ' days';
      if (h >= 1) return h.toFixed(1) + ' hours';
      return Math.max(1, Math.round(h * 60)) + ' minutes';
    }
    function fmtPKR(n) { return 'PKR ' + Math.round(n).toLocaleString('en-PK'); }

    function totals() {
      var loadW = 0, surgeW = 0, dailyWh = 0, count = 0;
      APPLIANCES.forEach(function (a) {
        var q = qty[a.id] || 0;
        loadW += a.watts * q;
        surgeW += a.surgeWatts * q;
        dailyWh += a.watts * a.hours * q;
        count += q;
      });
      surgeW = Math.max(surgeW, loadW);
      return { loadW: loadW, surgeW: surgeW, dailyWh: dailyWh, count: count };
    }

    function recommend(t, targetH) {
      // Energy the battery must actually deliver, adjusted for inverter losses.
      var requiredUsable = (t.loadW * targetH) / CALC.INVERTER_EFF / 1000;
      for (var i = 0; i < PACKS.length; i++) {
        var p = PACKS[i];
        if (
          t.loadW <= p.maxWatts &&
          t.surgeW <= p.maxWatts * 1.6 &&
          p.usableKwh >= requiredUsable &&
          t.dailyWh / 1000 <= p.usableKwh
        ) {
          return { pack: p, requiredUsable: requiredUsable };
        }
      }
      return { pack: null, requiredUsable: requiredUsable };
    }

    function waMessage(t, targetH, packName) {
      var summary = APPLIANCES
        .filter(function (a) { return qty[a.id] > 0; })
        .map(function (a) { return qty[a.id] + 'x ' + a.label; })
        .join(', ');
      return 'Assalam-o-Alaikum RAM3nergy! I just used your online load calculator.\n\n' +
        'My connected load: ' + fmtW(t.loadW) + '\n' +
        'Appliances (' + t.count + ' items): ' + summary + '\n' +
        'Daily energy need: ~' + Math.round(t.dailyWh) + ' Wh\n' +
        'Recommended pack: ' + packName + '\n' +
        'Backup target: ' + targetH + ' hour(s)\n\n' +
        'Please confirm the sizing and share a quotation.';
    }

    function render() {
      var t = totals();
      var targetH = parseInt($('backup-hours').value, 10);

      if (t.count === 0) {
        emptyEl.classList.remove('hidden');
        resultEl.classList.add('hidden');
        customEl.classList.add('hidden');
        return;
      }
      emptyEl.classList.add('hidden');

      var rec = recommend(t, targetH);

      if (!rec.pack) {
        resultEl.classList.add('hidden');
        customEl.classList.remove('hidden');
        $('c-required').textContent = rec.requiredUsable.toFixed(1) + ' kWh+';
        var cmsg = waMessage(t, targetH, 'Marco Polo (custom C&I BESS)');
        $('c-cta').href = 'https://wa.me/' + WA_NUMBER + '?text=' + encodeURIComponent(cmsg);
        $('c-cta').target = '_blank';
        $('c-cta').rel = 'noopener noreferrer';
        return;
      }

      customEl.classList.add('hidden');
      resultEl.classList.remove('hidden');

      var p = rec.pack;
      var runtimeH = (p.usableKwh * 1000 * CALC.INVERTER_EFF) / t.loadW;
      var coversDaily = p.usableKwh * 1000 >= t.dailyWh;

      $('r-load').textContent = fmtW(t.loadW);
      $('r-surge').textContent = fmtW(t.surgeW);
      $('r-daily').textContent = Math.round(t.dailyWh) + ' Wh (' + (t.dailyWh / 1000).toFixed(1) + ' kWh)';
      $('r-pack').textContent = p.name;
      $('r-series').textContent = SERIES_LABEL[p.series] || 'Commercial BESS';
      $('r-runtime').textContent = fmtHours(runtimeH);
      $('r-covers').textContent = coversDaily ? 'Yes — full day covered' : 'Partial — solar top-up advised';
      $('r-price').textContent = PRICES[p.id] ? fmtPKR(PRICES[p.id]) + ' *' : 'On quotation';

      var msg = waMessage(t, targetH, p.name);
      $('r-cta').href = 'https://wa.me/' + WA_NUMBER + '?text=' + encodeURIComponent(msg);
    }

    // Wire up steppers and inputs.
    document.querySelectorAll('[data-appliance]').forEach(function (row) {
      var id = row.getAttribute('data-appliance');
      var input = row.querySelector('[data-qty]');
      var meta = APPLIANCES.find(function (a) { return a.id === id; });

      function set(v) {
        v = Math.max(0, Math.min(meta.max, v));
        qty[id] = v;
        input.value = v;
        render();
      }

      row.querySelectorAll('button').forEach(function (btn) {
        btn.addEventListener('click', function () {
          set(qty[id] + (btn.getAttribute('data-action') === 'inc' ? 1 : -1));
        });
      });
      input.addEventListener('input', function () {
        var v = parseInt(input.value, 10);
        if (isNaN(v)) return;
        v = Math.max(0, Math.min(meta.max, v));
        qty[id] = v;
        render();
      });
      input.addEventListener('blur', function () { input.value = qty[id]; });
    });

    $('backup-hours').addEventListener('change', render);
    render();
  })();
</script>
