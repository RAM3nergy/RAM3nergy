---
const stats = [
  { value: '500+', label: 'Packs delivered nationwide' },
  { value: '48 h', label: 'Local service SLA (ISB/RWP)' },
  { value: '6,000+', label: 'Rated cell cycles @ 80% DoD' },
  { value: '5 yr', label: 'Warranty on Markhor Series' },
];
---

<section id="top" class="relative overflow-hidden bg-secondary pb-20 pt-28 lg:pb-28 lg:pt-40">
  <!-- background flourishes -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute -right-32 -top-32 h-96 w-96 rounded-full bg-primary/30 blur-3xl"></div>
    <div class="absolute -left-24 top-1/2 h-80 w-80 rounded-full bg-accent/15 blur-3xl"></div>
    <svg class="absolute inset-0 h-full w-full opacity-[0.04]" aria-hidden="true">
      <defs>
        <pattern id="hero-grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M40 0H0v40" fill="none" stroke="white" stroke-width="1" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#hero-grid)" />
    </svg>
  </div>

  <div class="container-ram relative">
    <div class="max-w-3xl">
      <span class="chip border-accent/30 bg-accent/10 text-accent">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent"></span>
        Cybersecurity &amp; Energy Engineering · Islamabad, Pakistan
      </span>

      <h1 class="mt-6 text-4xl font-extrabold leading-tight tracking-tight text-white sm:text-5xl lg:text-6xl">
        Zero Load-Shedding.
        <span class="block bg-gradient-to-r from-accent to-emerald-400 bg-clip-text text-transparent">
          Engineered in Pakistan.
        </span>
      </h1>

      <p class="mt-6 max-w-2xl text-base leading-relaxed text-slate-300 sm:text-lg">
        RAM3nergy builds high-precision solar systems and custom LiFePO4 battery packs with
        world-class cells and indigenous engineering — every cell lab-tested, every pack
        QR-traceable, every install backed by a real local warranty.
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a href="#calculator" class="btn btn-accent text-base">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-5 w-5" aria-hidden="true">
            <rect x="4" y="2" width="16" height="20" rx="2" />
            <path d="M8 6h8M8 10h.01M12 10h.01M16 10h.01M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01M16 18h.01" />
          </svg>
          Calculate Your Load
        </a>
        <a href="#tiers" class="btn btn-ghost-dark text-base">
          Explore Tiers
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <p class="mt-4 text-xs text-slate-400">
        World-Class Cells, Indigenous Engineering — free sizing consult for Islamabad &amp; Rawalpindi.
      </p>
    </div>

    <!-- Stats band -->
    <dl class="mt-16 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 lg:grid-cols-4">
      {stats.map((s) => (
        <div class="bg-secondary/80 px-6 py-6 backdrop-blur">
          <dt class="order-2 mt-1 block text-xs font-medium uppercase tracking-wide text-slate-400">{s.label}</dt>
          <dd class="text-2xl font-extrabold text-white sm:text-3xl">{s.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
